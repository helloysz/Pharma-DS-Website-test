---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import SectionHead from "../components/SectionHead.astro";
import KeyDates from "../components/KeyDates.astro";
import EmbedForm from "../components/EmbedForm.astro";
import site from "../data/site.json";

const includes = [
  "Access to all conference sessions",
  "Keynote and panel discussion",
  "Hybrid sessions: traditional talks, rapid demos & experience sharing",
  "Career-growth & networking program",
  "Evening banquet",
];

const tiers = [
  { name: "Early registration", price: "TODO", note: "Best value — closes early." },
  { name: "Standard registration", price: "TODO", note: "Full in-person access." },
  { name: "Virtual registration", price: "TODO", note: "Attend online." },
  { name: "Student / academic", price: "TODO", note: "Discounted rate for students." },
];

const regUrl = site.links.registration;
const regReady = regUrl && !regUrl.includes("TODO");
---

<BaseLayout title="Registration" description="Register for PharmaDS 2027. Registration rates, key dates, and the register-interest form.">
  <PageHero
    eyebrow="Registration"
    title="Register for PharmaDS 2027"
    subtitle="Secure your place at the conference. Rates and the registration portal will open soon — register your interest now to be notified the moment it does."
  >
    <div class="hero-actions">
      {regReady
        ? <a class="btn btn--light" href={regUrl}>Register now</a>
        : <a class="btn btn--light" href="#interest">Register your interest</a>}
      <a class="btn btn--ghost" href="/venue">Venue & travel</a>
    </div>
    <p class="todo-note" style="margin-top:1.2rem; max-width:60ch;">TODO: add the live registration portal link in <code>src/data/site.json</code> (links.registration).</p>
  </PageHero>

  <!-- RATES -->
  <section class="section">
    <div class="container">
      <SectionHead eyebrow="Rates" title="Registration options" />
      <div class="grid grid--4">
        {tiers.map((t) => (
          <div class="card tier">
            <h3>{t.name}</h3>
            <p class="tier__price">{t.price === "TODO" ? "TBA" : t.price}</p>
            <p class="tier__note">{t.note}</p>
          </div>
        ))}
      </div>
      <p class="todo-note" style="margin-top:1.5rem;">TODO: confirm 2027 registration rates.</p>
    </div>
  </section>

  <!-- INCLUDES + DATES -->
  <section class="section section--soft">
    <div class="container reg-grid">
      <div>
        <SectionHead eyebrow="What's included" title="Your registration covers" />
        <ul class="includes">
          {includes.map((i) => <li>{i}</li>)}
        </ul>
      </div>
      <aside>
        <h3>Key dates</h3>
        <KeyDates />
      </aside>
    </div>
  </section>

  <!-- REGISTER INTEREST -->
  <section class="section" id="interest">
    <div class="container narrow">
      <SectionHead eyebrow="Not ready yet?" title="Register your interest" center={true}>
        <p class="lead" style="margin-inline:auto;">Leave your details and we'll notify you when registration opens and share key updates.</p>
      </SectionHead>
      <EmbedForm
        url={site.forms.registerInterest}
        title="PharmaDS 2027 Register Interest Form"
        description="Be first to know when registration opens."
      />
    </div>
  </section>
</BaseLayout>

<style>
  .hero-actions { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 1.5rem; }
  .narrow { max-width: 820px; }

  .tier { text-align: center; }
  .tier h3 { font-size: 1.05rem; }
  .tier__price { font-size: 1.8rem; font-weight: 800; color: var(--indigo-bright); margin: 0.3rem 0; }
  .tier__note { color: var(--text-soft); margin: 0; font-size: 0.9rem; }

  .reg-grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 3rem; align-items: start; }
  .includes { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.7rem; }
  .includes li { position: relative; padding-left: 1.8rem; font-weight: 500; }
  .includes li::before { content: "✓"; position: absolute; left: 0; color: var(--cyan-deep); font-weight: 800; }
  aside h3 { margin-bottom: 1rem; }
  @media (max-width: 860px) { .reg-grid { grid-template-columns: 1fr; gap: 2rem; } }
</style>
