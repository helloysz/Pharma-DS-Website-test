---
import BaseLayout from '../layouts/BaseLayout.astro';
import SessionFormat from '../components/SessionFormat.astro';
import WhoShouldAttend from '../components/WhoShouldAttend.astro';
import sessions from '../data/sessions.json';
---

<BaseLayout title="Program & Agenda" description="2027 Conference Program, Agenda, and Session Formats">
  <div class="container" style="padding: var(--spacing-2xl) 0;">
    <h1 style="text-align: center; margin-bottom: var(--spacing-lg);">2027 Program & Agenda</h1>
    <p style="text-align: center; color: var(--color-text-light); margin-bottom: var(--spacing-2xl); max-width: 800px; margin-left: auto; margin-right: auto;">
      The PharmaDS 2027 conference brings together industry leaders and innovators across three intensive days of technical sessions, workshops, networking, and career development.
    </p>

    <!-- Placeholder for agenda layout -->
    <div style="background-color: var(--color-bg-light); padding: var(--spacing-2xl); border-radius: 0.5rem; margin: var(--spacing-2xl) 0; border-left: 4px solid var(--color-primary);">
      <h2 style="margin-bottom: var(--spacing-lg);">TODO: Detailed Agenda</h2>
      <p style="color: var(--color-text-light);">
        Full agenda with dates, times, and session details will be published closer to the conference. Below is the overview of conference features.
      </p>
    </div>

    <!-- Program Overview -->
    <section style="margin: var(--spacing-2xl) 0;">
      <h2 style="text-align: center; margin-bottom: var(--spacing-lg);">Program Highlights</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: var(--spacing-lg);">
        <div style="background-color: white; padding: var(--spacing-lg); border-radius: 0.5rem; border: 1px solid var(--color-border);">
          <h3 style="color: var(--color-primary); margin-bottom: var(--spacing-md);">🎓 Short Courses</h3>
          <p>Pre-conference hands-on training across Statistical Evidence Generation, AI Engineering, and Tool Usage tracks.</p>
          <a href="/short-courses" style="color: var(--color-primary); font-weight: 600; text-decoration: none;">Explore Short Courses →</a>
        </div>
        <div style="background-color: white; padding: var(--spacing-lg); border-radius: 0.5rem; border: 1px solid var(--color-border);">
          <h3 style="color: var(--color-primary); margin-bottom: var(--spacing-md);">📢 Keynote Sessions</h3>
          <p>Featured speakers exploring cutting-edge research, regulatory innovations, and strategic directions in pharma data science.</p>
        </div>
        <div style="background-color: white; padding: var(--spacing-lg); border-radius: 0.5rem; border: 1px solid var(--color-border);">
          <h3 style="color: var(--color-primary); margin-bottom: var(--spacing-md);">🤝 Panel Discussions</h3>
          <p>Expert panel conversations on industry trends, career development, and the future of pharmaceutical data science.</p>
        </div>
        <div style="background-color: white; padding: var(--spacing-lg); border-radius: 0.5rem; border: 1px solid var(--color-border);">
          <h3 style="color: var(--color-primary); margin-bottom: var(--spacing-md);">🎤 Presentation Sessions</h3>
          <p>Research presentations, rapid demos, experience-sharing, and summit-style hybrid sessions across diverse topics.</p>
        </div>
        <div style="background-color: white; padding: var(--spacing-lg); border-radius: 0.5rem; border: 1px solid var(--color-border);">
          <h3 style="color: var(--color-primary); margin-bottom: var(--spacing-md);">🌃 Networking & Social</h3>
          <p>Welcome reception, lunch & learn sessions, career growth activities, and a closing banquet.</p>
        </div>
        <div style="background-color: white; padding: var(--spacing-lg); border-radius: 0.5rem; border: 1px solid var(--color-border);">
          <h3 style="color: var(--color-primary); margin-bottom: var(--spacing-md);">📝 Call for Presentations</h3>
          <p>Submit your abstract to present research, demos, or experiences. Multiple formats welcome!</p>
          <a href="/call-for-presentations" style="color: var(--color-primary); font-weight: 600; text-decoration: none;">Submit an Abstract →</a>
        </div>
      </div>
    </section>
  </div>

  <!-- Session Formats -->
  <SessionFormat />

  <!-- Who Should Attend -->
  <WhoShouldAttend />
</BaseLayout>
