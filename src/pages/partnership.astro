---
import BaseLayout from '../layouts/BaseLayout.astro';
import PartnerLogos from '../components/PartnerLogos.astro';
import EmbedForm from '../components/EmbedForm.astro';
import partners from '../data/partners.json';
---

<BaseLayout title="Partnership" description="Sponsorship opportunities for PharmaDS 2027">
  <div class="container" style="padding: var(--spacing-2xl) 0;">
    <h1 style="text-align: center; margin-bottom: var(--spacing-lg);">Partnership Opportunities</h1>
    <p style="text-align: center; color: var(--color-text-light); margin-bottom: var(--spacing-2xl); max-width: 800px; margin-left: auto; margin-right: auto;">
      PharmaDS 2027 brings together leading professionals in pharmaceutical data science. Partner with us to reach a highly engaged audience of statisticians, data scientists, AI engineers, and industry leaders.
    </p>

    <!-- Partnership Value Proposition -->
    <section style="background-color: var(--color-bg-light); padding: var(--spacing-2xl); border-radius: 0.5rem; margin: var(--spacing-2xl) 0;">
      <h2 style="color: var(--color-primary); margin-bottom: var(--spacing-lg); text-align: center;">Why Partner with PharmaDS?</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: var(--spacing-lg); max-width: 900px; margin: 0 auto;">
        <div style="background-color: white; padding: var(--spacing-lg); border-radius: 0.5rem; border-left: 4px solid var(--color-primary);">
          <h3 style="color: var(--color-primary); margin-bottom: var(--spacing-md);">📊 Reach a Targeted Audience</h3>
          <p style="color: var(--color-text-light);">
            Connect with 500+ pharmaceutical statisticians, data scientists, and AI engineers from leading companies and academic institutions.
          </p>
        </div>
        <div style="background-color: white; padding: var(--spacing-lg); border-radius: 0.5rem; border-left: 4px solid var(--color-secondary);">
          <h3 style="color: var(--color-secondary); margin-bottom: var(--spacing-md);">🎯 Brand Visibility</h3>
          <p style="color: var(--color-text-light);">
            Showcase your company across digital platforms, conference materials, and networking events throughout the three-day conference.
          </p>
        </div>
        <div style="background-color: white; padding: var(--spacing-lg); border-radius: 0.5rem; border-left: 4px solid #059669;">
          <h3 style="color: #059669; margin-bottom: var(--spacing-md);">🤝 Networking Opportunities</h3>
          <p style="color: var(--color-text-light);">
            Engage directly with decision-makers and talent through sponsorship packages including booth spaces and speaking slots.
          </p>
        </div>
        <div style="background-color: white; padding: var(--spacing-lg); border-radius: 0.5rem; border-left: 4px solid #f59e0b;">
          <h3 style="color: #f59e0b; margin-bottom: var(--spacing-md);">📈 Thought Leadership</h3>
          <p style="color: var(--color-text-light);">
            Position your company as an innovator by sponsoring sessions, speaking, or providing tools demonstrations.
          </p>
        </div>
        <div style="background-color: white; padding: var(--spacing-lg); border-radius: 0.5rem; border-left: 4px solid #8b5cf6;">
          <h3 style="color: #8b5cf6; margin-bottom: var(--spacing-md);">💼 Recruitment Pipeline</h3>
          <p style="color: var(--color-text-light);">
            Access to top-tier talent actively engaged in the data science community and open to new opportunities.
          </p>
        </div>
        <div style="background-color: white; padding: var(--spacing-lg); border-radius: 0.5rem; border-left: 4px solid #ec4899;">
          <h3 style="color: #ec4899; margin-bottom: var(--spacing-md);">🌱 Community Impact</h3>
          <p style="color: var(--color-text-light);">
            Support the growth of the PharmaDS community and help advance data science education and mentorship.
          </p>
        </div>
      </div>
    </section>

    <!-- Sponsorship Tiers -->
    <section style="margin: var(--spacing-2xl) 0;">
      <h2 style="color: var(--color-primary); text-align: center; margin-bottom: var(--spacing-2xl);">Sponsorship Tiers</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--spacing-lg);">
        {partners.sponsorshipTiers.map((tier) => (
          <div style="background-color: var(--color-bg-light); padding: var(--spacing-lg); border-radius: 0.5rem; border: 2px solid var(--color-border);">
            <h3 style="color: var(--color-primary); margin-bottom: var(--spacing-md); text-align: center;">{tier.name}</h3>
            <div style="text-align: center; margin-bottom: var(--spacing-lg);">
              <p style="font-size: var(--font-size-2xl); font-weight: 700; color: var(--color-primary); margin-bottom: var(--spacing-sm);">{tier.price}</p>
            </div>
            <ul style="list-style: none; display: grid; gap: var(--spacing-sm);">
              {tier.benefits.map((benefit) => (
                <li style="display: flex; gap: var(--spacing-md);">
                  <span style="color: var(--color-success); font-weight: 700;">✓</span>
                  <span style="color: var(--color-text-light);">{benefit}</span>
                </li>
              ))}
            </ul>
            <button class="btn-primary" style="width: 100%; margin-top: var(--spacing-lg);">Inquire</button>
          </div>
        ))}
      </div>
    </section>

    <!-- Current Partners -->
    <section style="margin: var(--spacing-2xl) 0;">
      <h2 style="color: var(--color-primary); text-align: center; margin-bottom: var(--spacing-lg);">Our Partners 2027</h2>
      <PartnerLogos partners={partners.partners} displayType="wall" />
    </section>

    <!-- Prospectus Download -->
    <section style="background: linear-gradient(135deg, var(--color-primary) 0%, var(--color-secondary) 100%); padding: var(--spacing-2xl); border-radius: 0.5rem; color: white; text-align: center; margin: var(--spacing-2xl) 0;">
      <h2 style="color: white; margin-bottom: var(--spacing-lg);">Download Sponsorship Prospectus</h2>
      <p style="margin-bottom: var(--spacing-lg); font-size: var(--font-size-lg);">
        Get detailed information about sponsorship packages, benefits, and activation opportunities.
      </p>
      <a href="TODO: Prospectus PDF Link" target="_blank" rel="noopener noreferrer" style="display: inline-block; background-color: var(--color-accent); color: white; padding: var(--spacing-md) var(--spacing-lg); border-radius: 0.375rem; text-decoration: none; font-weight: 600;">
        📄 Download Prospectus (PDF)
      </a>
    </section>

    <!-- Partnership Inquiry Form -->
    <section style="margin: var(--spacing-2xl) 0;">
      <EmbedForm 
        title="Partnership Inquiry"
        description="Interested in becoming a sponsor or partner? Fill out the form below and our partnership team will contact you shortly."
        formUrl="TODO: Partnership Inquiry Form URL"
        embedType="google-form"
      />
    </section>

    <!-- Contact -->
    <section style="text-align: center; background-color: var(--color-bg-light); padding: var(--spacing-2xl); border-radius: 0.5rem; margin: var(--spacing-2xl) 0;">
      <h2 style="color: var(--color-primary); margin-bottom: var(--spacing-md);">Have Questions?</h2>
      <p style="color: var(--color-text-light); margin-bottom: var(--spacing-lg);">Our partnership team is ready to discuss custom sponsorship opportunities.</p>
      <a href="mailto:partnerships@pharmads.org" style="color: var(--color-primary); font-weight: 600; font-size: var(--font-size-lg);">partnerships@pharmads.org</a>
    </section>
  </div>
</BaseLayout>
