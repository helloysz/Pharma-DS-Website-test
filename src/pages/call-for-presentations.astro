---
import BaseLayout from '../layouts/BaseLayout.astro';
import EmbedForm from '../components/EmbedForm.astro';
import SessionFormat from '../components/SessionFormat.astro';
import keyDates from '../data/key-dates.json';
---

<BaseLayout title="Call for Presentations" description="Submit your abstract for PharmaDS 2027">
  <div class="container" style="padding: var(--spacing-2xl) 0;">
    <h1 style="text-align: center; margin-bottom: var(--spacing-lg);">Call for Presentations</h1>
    <p style="text-align: center; color: var(--color-text-light); margin-bottom: var(--spacing-2xl); max-width: 800px; margin-left: auto; margin-right: auto;">
      We welcome presentations from researchers, practitioners, and innovators across the pharma data science community. Submit your abstract today!
    </p>

    <!-- Important Dates -->
    <div style="background-color: var(--color-primary-light); color: white; padding: var(--spacing-2xl); border-radius: 0.5rem; margin: var(--spacing-2xl) 0;">
      <h2 style="color: white; text-align: center; margin-bottom: var(--spacing-lg);">Important Dates</h2>
      <div style="display: grid; gap: var(--spacing-md); max-width: 600px; margin: 0 auto;">
        <div style="display: flex; justify-content: space-between;">
          <strong>Call Opens:</strong>
          <span>{keyDates.dates.callForPresentationsOpen}</span>
        </div>
        <div style="display: flex; justify-content: space-between;">
          <strong>Submission Deadline:</strong>
          <span>{keyDates.dates.abstractSubmissionDeadline}</span>
        </div>
        <div style="display: flex; justify-content: space-between;">
          <strong>Acceptance Notifications:</strong>
          <span>TODO: Notification Date TBD</span>
        </div>
      </div>
    </div>

    <!-- Presentation Styles -->
    <section style="margin: var(--spacing-2xl) 0;">
      <h2 style="text-align: center; margin-bottom: var(--spacing-lg);">Presentation Styles</h2>
      <p style="text-align: center; color: var(--color-text-light); margin-bottom: var(--spacing-lg);">
        We accept submissions in multiple formats to showcase diverse perspectives and innovations.
      </p>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: var(--spacing-lg);">
        <div style="background-color: var(--color-bg-light); padding: var(--spacing-lg); border-radius: 0.5rem; border-left: 4px solid var(--color-primary);">
          <h3 style="color: var(--color-primary); margin-bottom: var(--spacing-md);">Traditional Presentation</h3>
          <p><strong>Duration:</strong> 45-60 minutes</p>
          <p style="color: var(--color-text-light);">Single speaker with Q&A. Ideal for in-depth technical presentations of research or case studies.</p>
        </div>

        <div style="background-color: var(--color-bg-light); padding: var(--spacing-lg); border-radius: 0.5rem; border-left: 4px solid var(--color-secondary);">
          <h3 style="color: var(--color-secondary); margin-bottom: var(--spacing-md);">Rapid Demo</h3>
          <p><strong>Duration:</strong> 15-20 minutes</p>
          <p style="color: var(--color-text-light);">Fast-paced live demonstration of tools, software, or workflows.</p>
        </div>

        <div style="background-color: var(--color-bg-light); padding: var(--spacing-lg); border-radius: 0.5rem; border-left: 4px solid #059669;">
          <h3 style="color: #059669; margin-bottom: var(--spacing-md);">Experience Sharing</h3>
          <p><strong>Duration:</strong> 30-45 minutes</p>
          <p style="color: var(--color-text-light);">Real-world experiences and lessons learned from a specific project or initiative.</p>
        </div>

        <div style="background-color: var(--color-bg-light); padding: var(--spacing-lg); border-radius: 0.5rem; border-left: 4px solid #f59e0b;">
          <h3 style="color: #f59e0b; margin-bottom: var(--spacing-md);">Multi-Speaker Session</h3>
          <p><strong>Duration:</strong> 120 minutes total</p>
          <p style="color: var(--color-text-light);">4-5 speakers present 20 minutes each on related topics (summit-style).</p>
        </div>
      </div>
    </section>

    <!-- Submission Guidelines -->
    <section style="background-color: var(--color-bg-light); padding: var(--spacing-2xl); border-radius: 0.5rem; margin: var(--spacing-2xl) 0;">
      <h2 style="margin-bottom: var(--spacing-lg);">Submission Guidelines</h2>
      <ul style="list-style: none; display: grid; gap: var(--spacing-md);">
        <li>✓ <strong>Title:</strong> Clear, concise, and descriptive</li>
        <li>✓ <strong>Abstract:</strong> 200-250 words explaining your topic, methodology, and key insights</li>
        <li>✓ <strong>Learning Outcomes:</strong> What will attendees learn?</li>
        <li>✓ <strong>Presentation Style:</strong> Choose from Traditional, Rapid Demo, Experience Sharing, or Multi-Speaker</li>
        <li>✓ <strong>Speaker(s):</strong> Name(s), affiliation(s), and email(s)</li>
        <li>✓ <strong>Technical Requirements:</strong> Any special AV or connectivity needs</li>
      </ul>
    </section>

    <!-- Abstract Submission Form -->
    <section style="margin: var(--spacing-2xl) 0;">
      <EmbedForm 
        title="Submit Your Abstract"
        description="Fill out the form below to submit your presentation abstract for PharmaDS 2027."
        formUrl="TODO: Google Form or Formspree URL"
        embedType="google-form"
      />
    </section>

    <!-- Questions? -->
    <section style="text-align: center; background-color: var(--color-bg-light); padding: var(--spacing-2xl); border-radius: 0.5rem; margin: var(--spacing-2xl) 0;">
      <h2 style="margin-bottom: var(--spacing-md);">Have Questions?</h2>
      <p style="color: var(--color-text-light); margin-bottom: var(--spacing-lg);">Contact our Program Committee for more information.</p>
      <a href="mailto:program@pharmads.org" style="color: var(--color-primary); font-weight: 600; font-size: var(--font-size-lg);">program@pharmads.org</a>
    </section>
  </div>
</BaseLayout>
