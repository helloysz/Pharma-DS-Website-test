---
import site from "../data/site.json";

type NavItem = {
  label: string;
  href: string;
  children?: { label: string; href: string }[];
};

const navItems: NavItem[] = [
  { label: "Program", href: "/program" },
  { label: "Short Courses", href: "/short-courses" },
  { label: "Call for Presentations", href: "/call-for-presentations" },
  {
    label: "Career & Networking",
    href: "/career-growth",
    children: [
      { label: "Mentorship & Networking", href: "/career-growth" },
      { label: "AI Projects", href: "/projects" },
    ],
  },
  { label: "Committee", href: "/committee" },
  { label: "Community", href: "/community" },
  { label: "Partnership", href: "/partnership" },
];

const { pathname } = Astro.url;
const isActive = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
const isGroupActive = (item: NavItem) =>
  isActive(item.href) || (item.children ?? []).some((c) => isActive(c.href));
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/" aria-label="PharmaDS 2027 home">
      <span class="brand-mark" aria-hidden="true">DS</span>
      <span class="brand-text">
        <strong>PharmaDS</strong>
        <span class="brand-year">2027</span>
      </span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" aria-hidden="true" />
    <label for="nav-toggle" class="nav-burger" aria-label="Toggle navigation menu">
      <span></span><span></span><span></span>
    </label>

    <nav class="site-nav" aria-label="Primary">
      <ul>
        {navItems.map((item) => (
          item.children ? (
            <li class="has-submenu">
              <a
                href={item.href}
                class={isGroupActive(item) ? "active" : ""}
                aria-haspopup="true"
              >
                {item.label}<span class="caret" aria-hidden="true">▾</span>
              </a>
              <ul class="submenu">
                {item.children.map((c) => (
                  <li>
                    <a href={c.href} class={isActive(c.href) ? "active" : ""}>{c.label}</a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a href={item.href} class={isActive(item.href) ? "active" : ""}>{item.label}</a>
            </li>
          )
        ))}
      </ul>
      <a class="btn btn--primary btn--sm nav-cta" href="/registration">Register</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: saturate(160%) blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 56px;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--ink);
  }
  .brand-mark {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 11px;
    background: var(--grad-accent);
    color: #fff;
    font-weight: 800;
    font-size: 0.95rem;
    letter-spacing: 0.02em;
  }
  .brand-text { display: flex; align-items: baseline; gap: 0.4rem; line-height: 1; }
  .brand-text strong {
    font-family: var(--font-display);
    font-size: 1.05rem;
    letter-spacing: -0.03em;
  }
  .brand-year {
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--cyan-deep);
  }

  .site-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  .site-nav ul {
    display: flex;
    align-items: center;
    gap: 1.3rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-nav a {
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.86rem;
    white-space: nowrap;
    padding-bottom: 2px;
    border-bottom: 2px solid transparent;
  }
  .site-nav a:hover { color: var(--indigo-bright); }
  .site-nav a.active {
    color: var(--indigo-bright);
    border-bottom-color: var(--indigo-bright);
  }
  .nav-cta { color: #fff !important; border-bottom: none !important; }

  /* Dropdown submenu */
  .has-submenu { position: relative; }
  .caret { font-size: 0.7em; margin-left: 0.28em; color: currentColor; }
  .site-nav .submenu {
    display: none;
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 220px;
    flex-direction: column;
    align-items: stretch;
    gap: 0;
    margin: 0.35rem 0 0;
    padding: 0.35rem;
    background: #fff;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-md);
    z-index: 60;
  }
  .has-submenu:hover > .submenu,
  .has-submenu:focus-within > .submenu { display: flex; }
  .site-nav .submenu li { border: none; }
  .site-nav .submenu a {
    display: block;
    padding: 0.5rem 0.65rem;
    border-radius: 6px;
    border-bottom: none;
    white-space: nowrap;
  }
  .site-nav .submenu a:hover { background: var(--bg-soft); }

  .nav-toggle { display: none; }
  .nav-burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 44px;
    height: 44px;
    cursor: pointer;
    border-radius: 10px;
  }
  .nav-burger span {
    display: block;
    height: 2px;
    width: 24px;
    background: var(--ink);
    border-radius: 2px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  @media (max-width: 1080px) {
    .nav-burger { display: flex; }
    .site-nav {
      position: fixed;
      inset: 56px 0 auto 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background: #fff;
      border-bottom: 1px solid var(--border);
      box-shadow: var(--shadow-md);
      padding: 0.5rem 0 1.2rem;
      transform: translateY(-130%);
      transition: transform 0.25s ease;
      max-height: calc(100vh - 56px);
      overflow-y: auto;
    }
    .site-nav ul { flex-direction: column; align-items: stretch; gap: 0; }
    .site-nav li { border-bottom: 1px solid var(--border); }
    .site-nav ul a {
      display: block;
      padding: 0.9rem clamp(1rem, 4vw, 2rem);
      font-size: 1rem;
      border-bottom: none;
    }
    .caret { display: none; }
    .site-nav .submenu {
      display: flex;
      position: static;
      min-width: 0;
      margin: 0;
      padding: 0;
      border: none;
      border-radius: 0;
      box-shadow: none;
    }
    .site-nav .submenu li { border-top: 1px solid var(--border); }
    .site-nav .submenu a {
      padding: 0.8rem clamp(2rem, 8vw, 3rem);
      font-size: 0.95rem;
      color: var(--text-soft);
    }
    .nav-cta {
      margin: 1rem clamp(1rem, 4vw, 2rem) 0;
      justify-content: center;
    }
    .nav-toggle:checked ~ .site-nav { transform: translateY(0); }
    .nav-toggle:checked ~ .nav-burger span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .nav-toggle:checked ~ .nav-burger span:nth-child(2) { opacity: 0; }
    .nav-toggle:checked ~ .nav-burger span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  }
</style>
