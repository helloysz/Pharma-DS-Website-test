---
export interface Props {
  title: string;
  description?: string;
  formUrl: string;
  embedType?: 'google-form' | 'formspree';
}

const { title, description, formUrl, embedType = 'google-form' } = Astro.props;
---

<div class="embed-form-wrapper" style="margin: 2rem 0;">
  <h3 style="margin-bottom: 0.5rem;">{title}</h3>
  {description && <p style="color: var(--color-text-light); font-size: var(--font-size-sm); margin-bottom: 1rem;">{description}</p>}
  
  {embedType === 'google-form' ? (
    <iframe 
      src={formUrl} 
      width="100%"
      height="500"
      frameborder="0"
      marginheight="0"
      marginwidth="0"
      style="border-radius: 0.375rem; border: 1px solid var(--color-border);"
    >
      Loading form...
    </iframe>
  ) : (
    <iframe 
      src={formUrl}
      width="100%"
      height="500"
      frameborder="0"
      style="border-radius: 0.375rem; border: 1px solid var(--color-border);"
    >
      Loading form...
    </iframe>
  )}

  <p style="font-size: var(--font-size-xs); color: var(--color-text-light); margin-top: 1rem;">
    Having trouble viewing the form? <a href={formUrl} target="_blank" rel="noopener noreferrer">Click here to open it directly.</a>
  </p>
</div>

<style>
  .embed-form-wrapper {
    width: 100%;
  }
</style>
