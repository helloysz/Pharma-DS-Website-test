---
interface Props {
  eyebrow?: string;
  title: string;
  center?: boolean;
}
const { eyebrow, title, center = false } = Astro.props;
---
<div class={`section-head ${center ? "section-head--center" : ""}`}>
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <h2>{title}</h2>
  <slot />
</div>
